@using MudBlazor

<div class="profile-section">

<div class="profile-grid">

    <!-- VÄNSTER: PERSONLIG INFO -->
    <div>
        <MudText Typo="Typo.h5" Color="Color.Primary">PERSONLIGT</MudText>

        <MudStack Spacing="2" Class="mt-3">
            <MudText>➤ Bor i: <b>Sverige</b></MudText>
            <MudText>➤ Studerar: <b>Systemutveckling .NET</b></MudText>
            <MudText>➤ Fokus: <b>Backend / Blazor</b></MudText>
            <MudText>➤ Intresse: <b>Tech, träning, content</b></MudText>
        </MudStack>
    </div>

    <!-- HÖGER: TECH STACK -->
    <div>
        <MudText Typo="Typo.h5" Color="Color.Primary">TECH STACK</MudText>

        <MudStack Row="true" Spacing="1" Class="flex-wrap mt-4">
            <MudChip T="string" Class="tech-pill">C#</MudChip>
            <MudChip T="string" Class="tech-pill">.NET</MudChip>
            <MudChip T="string" Class="tech-pill">Entity Framework</MudChip>
            <MudChip T="string" Class="tech-pill">SQL</MudChip>
            <MudChip T="string" Class="tech-pill">Blazor</MudChip>
            <MudChip T="string" Class="tech-pill">MudBlazor</MudChip>
            <MudChip T="string" Class="tech-pill">Git</MudChip>
        </MudStack>
    </div>

</div>
</div>