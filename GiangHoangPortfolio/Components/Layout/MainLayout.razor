@inherits LayoutComponentBase
@using MudBlazor

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>

    <MudAppBar Color="Color.Transparent" Elevation="0">
        <MudText Typo="Typo.h6">GiangHoang.dev</MudText>
        <MudSpacer />
        <MudButton Href="/" Color="Color.Inherit">Home</MudButton>
        <MudButton Href="/about" Color="Color.Inherit">About</MudButton>
        <MudButton Href="/projects" Color="Color.Inherit">Projects</MudButton>
        <MudButton Href="/cv" Color="Color.Inherit">CV</MudButton>
        <MudButton Href="/contact" Color="Color.Inherit">Contact</MudButton>
    </MudAppBar>

    <div class="hero-layout">

        <!-- Vänstersida: alltid synlig -->
        <div class="profile-column">
            <div class="profile-card">
                <img src="/images/IMG_92352.jpg" alt="Giang Hoang" />
            </div>
        </div>

        <!-- Mitten: byts per sida -->
        <div class="hero-content">
            @Body
        </div>

    </div>

</MudLayout>